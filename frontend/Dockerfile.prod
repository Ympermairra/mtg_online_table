# Продовая сборка: собираем статику и раздаём её nginx на порту 5173,
# чтобы внешний nginx (upstream frontend:5173) не пришлось менять
FROM node:22-alpine AS build
WORKDIR /app
COPY package*.json ./
RUN npm install
COPY . .
RUN npm run build

FROM nginx:alpine
COPY nginx.prod.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 5173
